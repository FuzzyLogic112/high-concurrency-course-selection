# 复制本文件为 .env 后按需修改。.env 不要提交到 git。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=course_selection

# ---- Redis ----
REDIS_PASSWORD=redis123456

# ---- RabbitMQ ----
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123456

# ---- 应用侧（毕设本体用得上，验证脚本只读 Redis 部分）----
JWT_SECRET=please-change-me-to-a-random-string-at-least-32-chars

# 扣减策略：direct / pessimistic / optimistic / redis_mq
# 第 6.3 节四方案对比实验就靠切换这一项，业务代码完全不动
DEDUCT_STRATEGY=redis_mq

# 令牌桶限流速率（次/秒）
RATE_LIMIT_QPS=2000
